# SweatReel environment template.
# Copy to .env for local development and fill in values.
# Real values live only in local .env (git-ignored) and the hosting dashboard.
# NEVER commit real secrets. Publishable/client values are safe to expose;
# values marked [SERVER ONLY] must never be exposed to the browser.

# --- Supabase (client + server) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# [SERVER ONLY] Privileged key — hosting dashboard only, never in client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
VITE_RAZORPAY_KEY_ID=your-publishable-key-id
# [SERVER ONLY] Payment secret — hosting dashboard only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI extraction (defaults to DISABLED unless exactly "true") ---
VITE_AI_EXTRACTION_ENABLED=false
AI_EXTRACTION_ENABLED=false
# [SERVER ONLY] Required only when AI is enabled.
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# --- Advertising (client, public) ---
VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_AD_SLOT=xxxxxxxxxx

# --- Optional / not currently referenced by app code ---
NODE_ENV=production
